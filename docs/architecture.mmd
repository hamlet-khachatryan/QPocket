%% QPocket — functional workflow and data state transitions (pluggable architecture)
%% Nodes are operations, edge labels are the values passed between them.
%% [REGISTRY] marks a plug-in point: the step asks that registry which function to run.
%% Render:  mmdc -i docs/architecture.mmd -o docs/architecture.svg

graph LR

%% ═══════════ 1 · CONFIG AND INGEST ═══════════
subgraph ING["1 · Config and ingest"]
  CFG["Load and Validate Config<br/>frozen; plug-in names and options checked"]
  SRC["Ingest Structures<br/>[SOURCES] pdb_query · local"]
  WS["Create Run Workspace<br/>layout v3 · metadata/run.json"]
end

CFG -->|"QPocketConfig"| WS
CFG -->|"source params"| SRC
WS -->|"Workspace"| SRC

%% ═══════════ 2 · REFERENCE ═══════════
subgraph REF["2 · Reference — built once"]
  RALN["Align and Clean the Reference"]
  RSAVE["Persist Reference<br/>metadata/reference.json"]
end

SRC -->|"Sources.reference"| RALN
RALN -->|"Reference"| RSAVE

%% ═══════════ 3 · PER-STRUCTURE CHAIN ═══════════
subgraph CHAIN["3 · Per-structure chain — one pipe per structure, any backend"]
  ALN["Align onto Reference"]
  CLN["Clean"]
  LIG["Find Site Ligands<br/>non-polymer, carbon-bearing, ≥ min_heavy_atoms"]
  PROT["Protonate Complex"]
  CON["Read Contacts<br/>[CONTACTS] prolif"]
  CAV["Detect Cavities<br/>once per structure"]
  FIN["Finish Record<br/>SMILES; sidecar with input fingerprint"]
end

SRC -->|"RawStructure ×N"| ALN
RSAVE -->|"Reference"| ALN
ALN -->|"Structure"| CLN
CLN -->|"Structure"| LIG
LIG -->|"Structure + ligands"| PROT
PROT -->|"protonated complex"| CON
CON -->|"potential · observed per ligand"| CAV
CAV -->|"structures/cavities"| FIN
ALN -.->|"Failure"| FAILS
CLN -.->|"Failure"| FAILS

%% ═══════════ 4 · COLLECT ═══════════
subgraph COL["4 · Collect"]
  COLL["Collect Records<br/>input order"]
  FAILS["failures.csv"]
  TABLES["master.csv · ligands.csv · HDF5 contact stores<br/>frequencies · actives.smi"]
  GRP["Group Ligands into Sites<br/>link_cutoff · sites.csv · grouping.json"]
  CLOUD["Cut One Cloud per Site per Structure<br/>box_padding · geodesics cached<br/>qpocket run stops here"]
end

FIN -->|"Structure ×N"| COLL
COLL --> TABLES
COLL --> FAILS
TABLES -->|"ligands + contacts"| GRP
GRP -->|"sites"| CLOUD

%% ═══════════ 5 · DISTANCES AND CLUSTERS ═══════════
subgraph SPEC["5 · Per-site analysis — explorer or qpocket site"]
  FEAT["Featurise the Site<br/>[FEATURES] + [CHARGES]"]
  FP["Fingerprints<br/>scaler · Laplacian · eigenbasis"]
  DIST["Distance Matrices<br/>shape · chemistry · combined"]
  CLU["Cluster Pockets<br/>[CLUSTERING] hierarchical · kmedoids · affinity"]
  OUT["clustering_metadata · representatives · params"]
end

CLOUD -->|"binding_site.csv"| FEAT
FEAT -->|"featurized.csv"| FP
FP -->|"Fingerprint ×N"| DIST
DIST -->|"Distances"| CLU
CLU -->|"ClusterAssignment"| OUT

%% ═══════════ 6 · ARMS ═══════════
subgraph ARMS["6 · Arms — over a finished run"]
  SCR["Screen<br/>[DECOYS] lude · [DOCKING] vina · quickvina"]
  CMP["Compare Pockets<br/>no run needed"]
  REC["Recluster<br/>from stored matrices"]
  VIZ["Explorer<br/>viz.grid · viz.ligands · viz.matrix"]
end

OUT -->|"representatives"| SCR
TABLES -->|"actives.smi"| SCR
DIST -->|"matrices"| REC
REC -->|"ClusterAssignment"| OUT
OUT --> VIZ
TABLES --> VIZ

%% ═══════════ 7 · EXECUTION ═══════════
subgraph EXEC["7 · Execution — same chain, three ways"]
  LOCAL["Local or Process Pool<br/>qpocket run · re-runs reuse finished structures"]
  SLURM["SLURM Arrays<br/>prepare · structure · sites · site_featurize · site_cluster<br/>job size from plug-in Resources"]
end

LOCAL -.->|"maps the chain"| ALN
SLURM -.->|"one array task per structure"| ALN
